# libreAI server configuration.
#
# Copy this file to .env, fill in your provider credentials, and restart the
# service. Process environment variables override values in this file.
#
# Keep this file private:
#   chmod 600 .env
# For the supplied systemd unit, install it as root:libreai with mode 0640
# instead; the service runs as the libreai group.

# --- Network and storage ---------------------------------------------------

# Bind to loopback by default. Use Tailscale Serve as the private entry point.
HOST=127.0.0.1
PORT=8080

# Relative paths are resolved from the process working directory.
DATABASE_PATH=./data/libreai.db

# --- Limits and timeouts ---------------------------------------------------

# Chats inactive for this many days are deleted automatically (default 30).
CHAT_RETENTION_DAYS=30

# Maximum duration of one upstream provider request, in seconds.
UPSTREAM_TIMEOUT_SECONDS=300

# Concurrent provider generations. Keep this small on old hardware.
MAX_CONCURRENT_GENERATIONS=2

# Maximum JSON request body accepted from the browser, in bytes.
MAX_REQUEST_BYTES=1048576

# Hard limits for conversation context sent to a provider.
MAX_CONTEXT_MESSAGES=200
MAX_CONTEXT_BYTES=400000

# Graceful shutdown window, in seconds.
SHUTDOWN_TIMEOUT_SECONDS=15

# debug, info, warn, error
LOG_LEVEL=info

# --- Providers -------------------------------------------------------------
#
# Provider variable names are:
#   PROVIDER_<ID>_<FIELD>
#
# <ID> starts with a lowercase letter and contains only a-z, 0-9, and _.
# Each provider uses the OpenAI-compatible endpoints:
#   POST {BASE_URL}/chat/completions
#   GET  {BASE_URL}/models              (when discovery is enabled)
#
# Fields:
#   ENABLED        true|false (default false)
#   DISPLAY_NAME   optional label shown in the interface
#   BASE_URL       required when enabled; normally ends in /v1
#   API_KEY        server-side secret; sent as "Authorization: Bearer ..."
#   NO_AUTH        true for a local server that needs no key (default false)
#   MODELS         comma-separated manual model IDs
#   DISCOVERY      true|false, default true
#   TIMEOUT_SECONDS  optional per-provider timeout (5-3600)
#   HEADERS        optional JSON object of extra headers, e.g. {"X-Team":"dev"}
#
# A provider is the same server-side config for every browser. API keys are
# never returned to the browser or written to logs.

# OpenAI
PROVIDER_OPENAI_ENABLED=false
PROVIDER_OPENAI_DISPLAY_NAME=OpenAI
PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_OPENAI_API_KEY=
PROVIDER_OPENAI_MODELS=

# Groq (OpenAI-compatible)
PROVIDER_GROQ_ENABLED=false
PROVIDER_GROQ_DISPLAY_NAME=Groq
PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_GROQ_API_KEY=
PROVIDER_GROQ_MODELS=

# A local OpenAI-compatible server with no authentication. This is just an
# example; libreAI itself never runs local model inference.
PROVIDER_LOCAL_ENABLED=false
PROVIDER_LOCAL_DISPLAY_NAME=Local
PROVIDER_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
PROVIDER_LOCAL_NO_AUTH=true
PROVIDER_LOCAL_MODELS=local-model
PROVIDER_LOCAL_DISCOVERY=false
